# ── Discord ───────────────────────────────────────────────
# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=여기에_봇_토큰

# 슬래시 명령을 즉시 등록할 서버(길드) ID. 비우면 글로벌 등록(최대 1시간 지연)
GUILD_ID=여기에_서버ID

# 이 역할을 가진 사람만 /start /stop 가능. 비우면 서버 멤버 누구나 허용
CONTROL_ROLE=

# 서버 준비 완료 알림을 보낼 채널 ID. 비우면 /start 를 실행한 채널로 전송
NOTIFY_CHANNEL_ID=

# ── GCP ───────────────────────────────────────────────────
GCP_PROJECT=palworld-bot-123456
PALWORLD_INSTANCE=palworld-server
PALWORLD_ZONE=asia-northeast3-a

# ── 팰월드 REST API (/players, 준비 알림용) ─────────────────
# 서버 설정에서 RESTAPIEnabled=True 로 켠 뒤 AdminPassword 를 여기에 입력.
# 비워두면 /players 와 준비 알림은 비활성화되고 나머지 기능만 동작.
PALWORLD_ADMIN_PASSWORD=
# 팰월드 VM REST 호스트. 비우면 GCP에서 VM 내부 IP를 자동 조회(권장).
PALWORLD_REST_HOST=
PALWORLD_REST_PORT=8212

# 로컬 PC에서 테스트할 때만 사용 (봇 VM에서는 attached SA를 쓰므로 비워둠)
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
